{
  "name": "shiftora-site",
  "version": "0.1.0",
  "description": "The two-page institutional site for Shiftora.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "verify": "npm run build && node scripts/verify-rebrand.mjs",
    "verify:visual": "npm run build && node scripts/visual-check.mjs",
    "verify:release": "npm run verify && node scripts/verify-fonts.mjs",
    "preview": "vite preview",
    "start": "serve dist -l ${PORT:-3000}"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serve": "^14.2.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "private": true
}
